{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseSettings": {
    "ConnectionString": "Host=localhost;Port=5545;Database=debtquery;Username=postgres;Password=*Password123"
  },
  "KeycloakSettings": {
    "Authority": "http://localhost:8080/realms/demo",
    "Audience": "account"
  },
  "AzureIntegrationSettings": {
    "ExceptionLogicAppsHttpTrigger": "https://prod-00.westus.logic.azure.com:443/workflows/1234567890abcdef1234567890abcdef/triggers/manual/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=abcdef1234567890abcdef1234567890",
    "ExceptionLogicAppsEmailDestination": "user@example.com"
  },
  "CacheSettings": {
    "ConnectionString": "localhost:6385",
    "InstanceName": "DebtQuerySystem:",
    "DefaultExpirationMinutes": 20
  },
  "CorsSettings": {
    "Origins": [
      "http://127.0.0.1:4200"
    ]
  }
